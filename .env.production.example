# ==============================================================================
# MailMind AI — Production SaaS Environment Template (.env.production)
# ==============================================================================
# Copy this file to .env (or backend/.env) before launching in production.
# NEVER commit the real .env file with actual credentials to Git.
# ==============================================================================

DEMO_MODE=false
ENVIRONMENT=production
LOG_LEVEL=INFO

# Cryptography (Generate: openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

# OAuth Token Encryption Key (Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=CHANGE_THIS_TO_A_VALID_FERNET_KEY_OR_STRONG_STABLE_PASSPHRASE

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://mailmind_user:CHANGE_POSTGRES_PASSWORD@localhost:5432/mailmind_production

# Google Cloud OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://app.mailmind.ai/api/v1/auth/google/callback

# Frontend & CORS
FRONTEND_URL=https://app.mailmind.ai
CORS_ORIGINS=https://app.mailmind.ai

# AI Intelligence
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
