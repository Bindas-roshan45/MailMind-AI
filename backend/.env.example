# ──────────────────────────────────────────────────────────────
# MailMind AI — Environment Variables Example
# Copy this file to .env and fill in your credentials.
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_USER=mailmind_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=mailmind_db
POSTGRES_PORT=5432

# ── Database URL (auto-generated from above, override if needed) ─────
DATABASE_URL=postgresql+asyncpg://mailmind_user:your_password_here@localhost:5432/mailmind_db

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=your_very_long_random_secret_key_here_change_this_in_production
ENCRYPTION_KEY=your_fernet_or_passphrase_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Google OAuth 2.0 (Future phases) ───────────────────────
# Created at: https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID → Web application
# Authorized redirect URIs: http://localhost:8000/auth/callback

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Required Gmail API scopes (do NOT change unless you know what you're doing):
# - https://www.googleapis.com/auth/gmail.readonly
# - https://www.googleapis.com/auth/gmail.send
# - https://www.googleapis.com/auth/gmail.compose
# - https://www.googleapis.com/auth/gmail.modify

# ── AI Provider (Future phases) ────────────────────────────
# Use ONE of the following:

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# OR Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

AI_PROVIDER=openai   # or: gemini

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Demo Mode ────────────────────────────────────────────────
# Set to "true" to serve mock data instead of connecting to real services
DEMO_MODE=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info