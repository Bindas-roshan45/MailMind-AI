# ──────────────────────────────────────────────────────────────
# MailMind AI — Environment Variables Example
# Copy this file to .env and fill in your credentials.
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_USER=mailmind_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=mailmind_db
POSTGRES_PORT=5432

# ── Database URL ─────────────────────────────────────────────
# Development: SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./mailmind.db
# Production: PostgreSQL (override when deploying)
# DATABASE_URL=postgresql+asyncpg://mailmind_user:your_password_here@localhost:5432/mailmind_db

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=your_very_long_random_secret_key_here_change_this_in_production
ENCRYPTION_KEY=your_fernet_or_passphrase_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Google OAuth 2.0 (Gmail Integration) ─────────────────────
# Created at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── AI Provider ──────────────────────────────────────────────
# Google Gemini (Default and Verified)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini

# Optional: OpenAI (fallback if configured)
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Demo Mode ────────────────────────────────────────────────
# Set to "true" to seed isolated demo data without requiring Gmail connection
DEMO_MODE=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info