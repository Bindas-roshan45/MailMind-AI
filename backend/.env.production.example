# ==============================================================================
# MailMind AI — Production SaaS Environment Template (.env.production)
# ==============================================================================
# IMPORTANT:
# 1. Never commit real credentials, secrets, or keys to version control.
# 2. In production (DEMO_MODE=false), MailMind AI strictly enforces:
#    - SECRET_KEY must be a random high-entropy key (>= 32 chars)
#    - ENCRYPTION_KEY must be explicitly set and stable across restarts.
# ==============================================================================

# ── Application Mode ──────────────────────────────────────────────────────────
# Must be 'false' for live production operation.
# Disables demo token generation and mock data seeding.
DEMO_MODE=false
ENVIRONMENT=production
ENV_FILE=./backend/.env.production
LOG_LEVEL=INFO

# ── Cryptography & Security ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

# Used to encrypt Google OAuth access/refresh tokens stored in the database.
# Must remain IDENTICAL across restarts; changing this will invalidate saved OAuth tokens.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_THIS_TO_A_VALID_FERNET_KEY_OR_STRONG_STABLE_PASSPHRASE

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Production requires PostgreSQL with asyncpg driver.
# Connection pooling (pool_pre_ping, pool_recycle=300s, max_overflow) is automatically configured.
POSTGRES_SERVER=postgres-db.internal
POSTGRES_PORT=5432
POSTGRES_USER=mailmind_admin
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=mailmind_production
DATABASE_URL=postgresql+asyncpg://mailmind_admin:CHANGE_THIS_STRONG_POSTGRES_PASSWORD@postgres-db.internal:5432/mailmind_production

# ── Google Cloud OAuth 2.0 (Gmail Integration) ────────────────────────────────
# Created in Google Cloud Console -> APIs & Services -> Credentials
# Production Redirect URI MUST use HTTPS.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://app.mailmind.ai/api/v1/auth/google/callback

# ── Frontend & CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=https://app.mailmind.ai
# Comma-separated list of allowed origins (no wildcards in production)
CORS_ORIGINS=https://app.mailmind.ai

# ── AI Provider Configuration ─────────────────────────────────────────────────
# Google Gemini API (Recommended for production speed & safety filtering)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-production-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Optional Fallback: OpenAI API
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o

# ── Background Worker & Rate Limiting ─────────────────────────────────────────
WORKER_POLL_INTERVAL_SECONDS=60
MAX_AUTO_REPLIES_PER_USER_PER_DAY=20
