# ==============================================================================
# MailMind AI — Staging SaaS Environment Template (.env.staging)
# ==============================================================================
# Use this configuration for your internal staging or QA pre-release environment.
# NEVER commit real credentials, secrets, or keys to version control.
# ==============================================================================

# ── Application Mode ──────────────────────────────────────────────────────────
# Setting DEMO_MODE=false runs full authentication and real PostgreSQL logic.
DEMO_MODE=false
ENVIRONMENT=staging
ENV_FILE=./backend/.env.staging
LOG_LEVEL=INFO

# ── Cryptography & Security ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

# Used to encrypt Google OAuth access/refresh tokens stored in the database.
# Must remain IDENTICAL across restarts; changing this will invalidate saved OAuth tokens.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_THIS_TO_A_VALID_FERNET_KEY_OR_STRONG_STABLE_PASSPHRASE

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Staging PostgreSQL connection string (asyncpg driver)
POSTGRES_SERVER=mailmind_postgres
POSTGRES_PORT=5432
POSTGRES_USER=mailmind_user
POSTGRES_PASSWORD=CHANGE_THIS_STAGING_PASSWORD
POSTGRES_DB=mailmind_staging
DATABASE_URL=postgresql+asyncpg://mailmind_user:CHANGE_THIS_STAGING_PASSWORD@mailmind_postgres:5432/mailmind_staging

# ── Google Cloud OAuth 2.0 (Gmail Integration) ────────────────────────────────
# In Google Cloud Console, add your staging redirect URI to Authorized Redirect URIs:
# https://staging.yourdomain.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-staging-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-staging-client-secret
GOOGLE_REDIRECT_URI=https://staging.yourdomain.com/api/v1/auth/google/callback

# ── Frontend & CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=https://staging.yourdomain.com
CORS_ORIGINS=https://staging.yourdomain.com

# ── AI Provider Configuration ─────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=your-staging-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Background Worker & Rate Limiting ─────────────────────────────────────────
WORKER_POLL_INTERVAL_SECONDS=60
MAX_AUTO_REPLIES_PER_USER_PER_DAY=20
